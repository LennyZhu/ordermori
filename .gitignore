*.provisionprofile
credentials.json
service-account*.json
*-service-account.json

# Native development caches and per-machine settings
ios/Pods/
ios/DerivedData/
android/.gradle/
android/.cxx/
android/local.properties
xcuserdata/
*.xcuserstate

# Development caches, temporary files and logs
.cache/
.metro-cache/
.metro-health-check*
.eslintcache
*.tsbuildinfo
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
*.tmp
*.swp
*.swo
*~

