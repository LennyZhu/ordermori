{
  "name": "ordermori",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios:device": "expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src tests --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:expo": "expo install --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-media-library": "58.0.13",
    "expo-router": "~58.0.27",
    "expo-sharing": "58.0.21",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "pako": "^2.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-media-library"
        ]
      }
    }
  }
}
